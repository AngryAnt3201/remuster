{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": { "@engine/*": ["engine/*"], "@base/*": ["base/src/*"] }
  },
  "include": ["engine", "base/src", "games", "tests", "tools", "vite.config.ts", "capacitor.config.ts"]
}
