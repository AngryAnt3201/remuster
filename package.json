{
  "name": "remuster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "art": "${BLENDER:-blender} -b --factory-startup -P art/render_all.py",
    "art:arenas": "${BLENDER:-blender} -b --factory-startup -P art/arenas/render_arenas.py",
    "art:maps": "${BLENDER:-blender} -b --factory-startup -P art/maps/render_maps.py",
    "art:keeps": "${BLENDER:-blender} -b --factory-startup -P art/keeps/render_keeps.py",
    "art:style": "${BLENDER:-blender} -b --factory-startup -P art/style/frames.py",
    "style:pick": "node tools/style-pick.mjs",
    "vfx": "/usr/local/bin/python3 art/vfx/make_vfx.py --contact",
    "art:title": "${BLENDER:-blender} -b --factory-startup -P art/ui/title_key.py && cwebp -quiet -q 80 art/ui/build/title_key.png -o base/public/ui/title-key.webp",
    "dev": "vite --host 0.0.0.0 --port ${PORT:-5300}",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "balance": "vite-node tools/balance.ts",
    "cap:sync": "npm run build && node tools/cap-sync.mjs",
    "ios:sim": "npm run cap:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath ios/App/build/dd CODE_SIGNING_ALLOWED=NO build",
    "ios:open": "npm run cap:sync && cap open ios",
    "ios:run": "npm run ios:sim && xcrun simctl install booted ios/App/build/dd/Build/Products/Debug-iphonesimulator/App.app && xcrun simctl launch booted co.inflect.muster",
    "e2e": "node tools/e2e.mjs .",
    "release:config": "node tools/release-config.mjs",
    "ios:release:dry": "sh tools/ios-release.sh dry",
    "ios:release": "sh tools/ios-release.sh archive",
    "ios:export": "sh tools/ios-release.sh export",
    "store:shots": "node tools/store-shots.mjs",
    "new": "node tools/new-game.mjs",
    "text": "vite-node tools/text-dump.ts",
    "engine:check": "node tools/engine-lock.mjs --check",
    "infra:dev": "vite-node infra/local/server.ts",
    "typecheck": "tsc --noEmit",
    "infra:deploy": "node infra/deploy.mjs",
    "publish": "node tools/publish.mjs",
    "music": "python3 tools/music/render.py game",
    "music:video": "python3 tools/music/render.py video"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright": "1.59",
    "typescript": "5.6",
    "vite": "^6.4.5",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/status-bar": "^8.0.4",
    "muster-store": "file:ios/MusterStore"
  }
}
